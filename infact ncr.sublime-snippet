int fact[N], infact[N];


int fast_pow(int x, int p) {
    if (p == 0 ) return 1;

    int ans = fast_pow((1ll * x * x) % mod, p / 2) % mod;

    if (p & 1) ans = (1ll * ans * x) % mod;
    return ans;
}

void pre_fact() {
    fact[0] = 1;
    for (int i = 1; i < N; i++) fact[i] = fact[i - 1] * i % mod;
    infact[N - 1] = fast_pow(fact[N - 1], mod - 2);
    for (int i = N - 2; i >= 0; i--) infact[i] = infact[i + 1] * (i + 1) % mod;
}


int ncr (int n, int r) {
    if (n < r || n < 0 || r < 0) return 0;

    int ans = fact[n] * infact[r] % mod * infact[n - r] % mod;
    return ans;
}

